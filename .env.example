# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenRouter — one key routes to Gemini, Grok, etc.  https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Gmail App Password (16 chars, NOT your login password)
# https://myaccount.google.com/apppasswords  (needs 2-Step Verification on)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional model overrides (defaults in config.py)
# DISCOVERY_MODEL=x-ai/grok-4.3
# CONTENT_MODEL=google/gemini-2.5-flash
# CAPTION_MODEL=google/gemini-2.5-flash
